{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "OrderService",
    "Audience": "OrderService"
  },
  "Kafka": {
    "BootstrapServers": "",
    "GroupId": "payment-service"
  },
  "Outbox": {
    "MaxRetryCount": 5
  },
  "DomainEventRecovery": {
    "RecoveryThresholdSeconds": 20,
    "PollingIntervalSeconds": 10
  },
  "Resilience": {
    "RetryCount": 3,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerBreakDurationSeconds": 30,
    "TimeoutSeconds": 10
  },
  "AllowedHosts": "*"
}
